# Polymarket LP Bot Configuration
# Copy this file to .env and fill in your values

# Your Ethereum private key (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Polymarket CLOB API host
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# Chain ID (137 = Polygon Mainnet)
CHAIN_ID=137

# === Risk Parameters ===
# Maximum USD exposure per single market position
MAX_EXPOSURE_PER_MARKET=200

# Maximum loss per position before market selling (USD)
MAX_LOSS_PER_POSITION=10

# Emergency dump threshold - full market sell (USD)
EMERGENCY_LOSS_THRESHOLD=30

# Minimum reward pool to consider a market (USD)
MIN_REWARD_POOL=30

# Maximum order book depth per price level (USD)
MAX_ORDERBOOK_DEPTH=50

# Maximum spread gap to provide liquidity (cents)
MAX_SPREAD_GAP=5

# Target share of market rewards (minimum %)
MIN_REWARD_SHARE_TARGET=30

# Order size in USD per side
ORDER_SIZE=15

# Bot scan interval in seconds
SCAN_INTERVAL=60

# Number of price levels to quote on each side
NUM_PRICE_LEVELS=3

# Minimum distance from midpoint (cents)
MIN_EDGE=0.5

# Maximum distance from midpoint (cents)
MAX_EDGE=3.0
