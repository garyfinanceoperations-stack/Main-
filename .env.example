# Polymarket LP Bot Configuration
# Copy this file to .env and fill in your values

# Your Ethereum private key (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Polymarket CLOB API host
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# Chain ID (137 = Polygon Mainnet)
CHAIN_ID=137

# === Budget Presets ===
# Current preset: $300 budget (conservative)
# See BUDGET_GUIDE below for scaling up

# === Risk Parameters ===
# Maximum USD exposure per single market position
MAX_EXPOSURE_PER_MARKET=120

# Maximum loss per position before market selling (USD)
MAX_LOSS_PER_POSITION=10

# Emergency dump threshold - full market sell (USD)
EMERGENCY_LOSS_THRESHOLD=25

# Portfolio-wide stop-loss (USD) - kills all positions
PORTFOLIO_STOP_LOSS=80

# Minimum reward pool to consider a market (USD)
MIN_REWARD_POOL=30

# Maximum order book depth per price level (USD)
MAX_ORDERBOOK_DEPTH=50

# Maximum spread gap to provide liquidity (cents)
MAX_SPREAD_GAP=5

# Target share of market rewards (minimum %)
MIN_REWARD_SHARE_TARGET=30

# Maximum number of markets to LP simultaneously
MAX_ACTIVE_MARKETS=5

# Order size in USD per side
ORDER_SIZE=10

# Bot scan interval in seconds
SCAN_INTERVAL=60

# Number of price levels to quote on each side
NUM_PRICE_LEVELS=2

# Minimum distance from midpoint (cents)
MIN_EDGE=0.5

# Maximum distance from midpoint (cents)
MAX_EDGE=2.5

# ============================================================
# BUDGET GUIDE - Estimated daily rewards at different budgets
# ============================================================
# Budget | ORDER_SIZE | LEVELS | MARKETS | MAX_EXPOSURE | Est. $/day
# -------|------------|--------|---------|--------------|----------
#  $300  |    10      |   2    |   5     |    120       |   $3-8
#  $500  |    15      |   2    |   6     |    160       |   $5-15
# $1000  |    20      |   3    |   7     |    200       |  $10-25
# $2000  |    30      |   3    |  10     |    300       |  $20-40
# $3500  |    40      |   3    |  12     |    400       |  $35-60
# $5000  |    50      |   3    |  15     |    500       |  $50-80
# ============================================================
# To hit $50/day consistently you need ~$3500-5000 deployed.
# This assumes 30%+ reward share in low-volume markets with
# $30-100/day reward pools. Actual results depend on market
# availability, competition, and how often positions get filled.
# ============================================================
